<h4 class="ui center aligned medium icon header">
    <i class="circular envelope outline blue icon">    </i>
    Say something!
</h4>


<div class="ui two column grid">
    <div class="twelve wide column">
        <div class="ui fluid raised chatbox card">
            <div class="content">
                <div class="ui feed">
                    <%= render @messages %>
                </div>
                
            </div>
            <div class="extra content">
                <form class="ui reply form">
                    <div class="field">
                        <div class="ui fluid icon input">
                            <input type="text" placeholder="Enter a message...">
                            <i class="icon inverted bordered blue edit"></i>
                        </div>
                    </div>
                </form>        
            </div>
        </div>
    </div>
    
    <div class="four wide column">
        <div class="ui fluid raised chatbox card">
            <div class="content">
                <div class="container"> 
                    <div class="ui inverted vertical menu">
                        <a class="item">
                            Home
                        </a>
                        <a class="item active">
                            Messages
                        </a>
                        <a class="item">
                            Friends
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>